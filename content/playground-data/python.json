{
  "$schema": "./playground.schema.json",
  "language": "python",
  "seeds": [
    {
      "id": "class-marks",
      "label": "Class marks",
      "description": "Defines students, a list of dictionaries with a name, a programme and a list of marks.",
      "code": [
        "students = [",
        "    {\"name\": \"Kabo\",      \"programme\": \"CS\",    \"marks\": [78, 64, 55]},",
        "    {\"name\": \"Naledi\",    \"programme\": \"CS\",    \"marks\": [91, 84, 77]},",
        "    {\"name\": \"Thato\",     \"programme\": \"CS\",    \"marks\": [48, 69]},",
        "    {\"name\": \"Lesedi\",    \"programme\": \"IS\",    \"marks\": [85, 72]},",
        "    {\"name\": \"Boitumelo\", \"programme\": \"Maths\", \"marks\": [88]},",
        "]"
      ]
    },
    {
      "id": "sample-text",
      "label": "Sample text",
      "description": "Defines text, a short paragraph, and words, its lower-case words with punctuation removed.",
      "code": [
        "text = \"\"\"Functional programming treats computation as the evaluation of functions.",
        "Pure functions make programs easier to test, and tested programs are easier to trust.",
        "Recursion replaces loops, and loops are replaced by recursion.\"\"\"",
        "words = [w.strip(\".,\").lower() for w in text.split()]"
      ]
    }
  ],
  "examples": [
    {
      "id": "hello-python",
      "label": "Hello, Python",
      "code": [
        "print(\"Hello, University Docs!\")",
        "print(2 + 3 * 4)",
        "print([n * 2 for n in range(5)])"
      ]
    },
    {
      "id": "variables-and-types",
      "label": "Variables and types",
      "code": [
        "name = \"Ada\"",
        "age = 36",
        "height = 1.68",
        "scores = [90, 72, 85]",
        "",
        "for value in (name, age, height, scores):",
        "    print(repr(value), \"->\", type(value).__name__)"
      ]
    },
    {
      "id": "loops-and-conditions",
      "label": "Loops and conditions",
      "code": [
        "for n in range(1, 16):",
        "    if n % 15 == 0:",
        "        print(\"FizzBuzz\")",
        "    elif n % 3 == 0:",
        "        print(\"Fizz\")",
        "    elif n % 5 == 0:",
        "        print(\"Buzz\")",
        "    else:",
        "        print(n)"
      ]
    },
    {
      "id": "functions-and-recursion",
      "label": "Functions and recursion",
      "code": [
        "def factorial(n):",
        "    return 1 if n <= 1 else n * factorial(n - 1)",
        "",
        "def fib(n, memo={}):",
        "    if n < 2:",
        "        return n",
        "    if n not in memo:",
        "        memo[n] = fib(n - 1) + fib(n - 2)",
        "    return memo[n]",
        "",
        "print(\"6! =\", factorial(6))",
        "print(\"fib(50) =\", fib(50))"
      ]
    },
    {
      "id": "lists-dicts-sets",
      "label": "Lists, dicts, sets",
      "code": [
        "words = \"the quick brown fox jumps over the lazy dog the end\".split()",
        "",
        "counts = {}",
        "for w in words:",
        "    counts[w] = counts.get(w, 0) + 1",
        "",
        "print(\"unique words:\", len(set(words)))",
        "print(\"most common :\", max(counts, key=counts.get), counts[max(counts, key=counts.get)])",
        "print(\"sorted      :\", sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))[:3])"
      ]
    },
    {
      "id": "classes",
      "label": "Classes",
      "code": [
        "class Account:",
        "    def __init__(self, owner, balance=0):",
        "        self.owner = owner",
        "        self.balance = balance",
        "",
        "    def deposit(self, amount):",
        "        if amount <= 0:",
        "            raise ValueError(\"deposit must be positive\")",
        "        self.balance += amount",
        "",
        "    def __repr__(self):",
        "        return f\"Account({self.owner!r}, {self.balance})\"",
        "",
        "acct = Account(\"Kabo\", 100)",
        "acct.deposit(50)",
        "print(acct)",
        "",
        "try:",
        "    acct.deposit(-5)",
        "except ValueError as err:",
        "    print(\"Error:\", err)"
      ]
    },
    {
      "id": "reading-input",
      "label": "Reading input",
      "code": [
        "# Type values in the Input box (one line per input() call), then press Run.",
        "name = input(\"Name? \")",
        "age = int(input(\"Age? \"))",
        "print(f\"Hello {name}, next year you will be {age + 1}.\")"
      ]
    },
    {
      "id": "error-to-diagnose",
      "label": "Error to diagnose",
      "code": [
        "numbers = [1, 2, 3]",
        "total = 0",
        "for i in range(4):",
        "    total += numbers[i]",
        "print(total)"
      ]
    },
    {
      "id": "class-marks-averages-and-best-student",
      "label": "Class marks: averages and best student",
      "seed": "class-marks",
      "code": [
        "# students is already defined by the Class marks dataset.",
        "for s in students:",
        "    average = sum(s[\"marks\"]) / len(s[\"marks\"])",
        "    print(f'{s[\"name\"]:<10} {average:5.1f}')",
        "",
        "best = max(students, key=lambda s: sum(s[\"marks\"]) / len(s[\"marks\"]))",
        "print(\"Best average:\", best[\"name\"])"
      ]
    },
    {
      "id": "class-marks-group-by-programme",
      "label": "Class marks: group by programme",
      "seed": "class-marks",
      "code": [
        "by_programme = {}",
        "for s in students:",
        "    by_programme.setdefault(s[\"programme\"], []).extend(s[\"marks\"])",
        "",
        "for programme, marks in sorted(by_programme.items()):",
        "    print(programme, \"->\", len(marks), \"marks, mean\", round(sum(marks) / len(marks), 1))"
      ]
    },
    {
      "id": "sample-text-word-frequencies",
      "label": "Sample text: word frequencies",
      "seed": "sample-text",
      "code": [
        "# words is already defined by the Sample text dataset.",
        "counts = {}",
        "for w in words:",
        "    counts[w] = counts.get(w, 0) + 1",
        "",
        "top = sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))[:5]",
        "for word, n in top:",
        "    print(f\"{word:<12} {n}\")"
      ]
    }
  ]
}
