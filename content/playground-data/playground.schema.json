{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Playground data file",
  "description": "Examples and seed datasets for one playground language. Loaded by lib/playground/data.ts.",
  "type": "object",
  "required": ["language", "seeds", "examples"],
  "properties": {
    "$schema": { "type": "string" },
    "language": { "enum": ["html", "javascript", "python", "sql", "haskell"] },
    "seeds": {
      "type": "array",
      "description": "Datasets that are run invisibly before the learner's code: SQL tables and rows, Python variables, JavaScript constants.",
      "items": {
        "type": "object",
        "required": ["id", "label", "description", "code"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "code": { "$ref": "#/definitions/code" }
        },
        "additionalProperties": false
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "code"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "label": { "type": "string" },
          "seed": { "type": "string", "description": "Id of a seed in this file that the example needs." },
          "stdin": { "type": "string", "description": "Pre-filled input for Python's input() calls." },
          "code": { "$ref": "#/definitions/code" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "code": {
      "description": "Source code. An array is one entry per line.",
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    }
  }
}
