{
  "$schema": "./playground.schema.json",
  "language": "sql",
  "seeds": [
    {
      "id": "university",
      "label": "University database",
      "description": "Three related tables: course, student and enrolment. One enrolment has a NULL mark, so you can practise IS NULL.",
      "code": [
        "CREATE TABLE course (",
        "  code    TEXT PRIMARY KEY,",
        "  title   TEXT NOT NULL,",
        "  credits INTEGER NOT NULL",
        ");",
        "CREATE TABLE student (",
        "  id        INTEGER PRIMARY KEY,",
        "  name      TEXT NOT NULL,",
        "  programme TEXT NOT NULL,",
        "  year      INTEGER NOT NULL",
        ");",
        "CREATE TABLE enrolment (",
        "  student_id  INTEGER REFERENCES student(id),",
        "  course_code TEXT REFERENCES course(code),",
        "  mark        INTEGER,",
        "  PRIMARY KEY (student_id, course_code)",
        ");",
        "",
        "INSERT INTO course VALUES",
        "  ('CSI141', 'Programming Principles', 12),",
        "  ('CSI142', 'Object-Oriented Programming', 12),",
        "  ('CSI243', 'Functional Programming', 12),",
        "  ('CSI247', 'Data Structures', 12),",
        "  ('CSI323', 'Algorithms', 12),",
        "  ('MAT221', 'Calculus II', 12);",
        "",
        "INSERT INTO student VALUES",
        "  (1, 'Kabo',      'Computer Science',    2),",
        "  (2, 'Naledi',    'Computer Science',    3),",
        "  (3, 'Thato',     'Computer Science',    2),",
        "  (4, 'Lesedi',    'Information Systems', 1),",
        "  (5, 'Tumelo',    'Computer Science',    3),",
        "  (6, 'Boitumelo', 'Mathematics',         2),",
        "  (7, 'Onkabetse', 'Computer Science',    1);",
        "",
        "INSERT INTO enrolment VALUES",
        "  (1, 'CSI141', 78), (1, 'CSI243', 64), (1, 'MAT221', 55),",
        "  (2, 'CSI243', 91), (2, 'CSI247', 84), (2, 'CSI323', 77),",
        "  (3, 'CSI141', 48), (3, 'CSI243', 69),",
        "  (4, 'CSI141', 85), (4, 'CSI142', 72),",
        "  (5, 'CSI247', 66), (5, 'CSI323', 58), (5, 'CSI243', 73),",
        "  (6, 'MAT221', 88),",
        "  (7, 'CSI141', NULL);"
      ]
    },
    {
      "id": "bookshop",
      "label": "Bookshop database",
      "description": "Authors, books and sales. Good for joins, GROUP BY and computing totals.",
      "code": [
        "CREATE TABLE author (",
        "  id      INTEGER PRIMARY KEY,",
        "  name    TEXT NOT NULL,",
        "  country TEXT",
        ");",
        "CREATE TABLE book (",
        "  id        INTEGER PRIMARY KEY,",
        "  title     TEXT NOT NULL,",
        "  author_id INTEGER REFERENCES author(id),",
        "  price     REAL NOT NULL,",
        "  published INTEGER",
        ");",
        "CREATE TABLE sale (",
        "  id       INTEGER PRIMARY KEY,",
        "  book_id  INTEGER REFERENCES book(id),",
        "  quantity INTEGER NOT NULL,",
        "  sold_on  TEXT NOT NULL",
        ");",
        "",
        "INSERT INTO author VALUES",
        "  (1, 'Bessie Head',     'Botswana'),",
        "  (2, 'Chinua Achebe',   'Nigeria'),",
        "  (3, 'Unity Dow',       'Botswana'),",
        "  (4, 'Ngugi wa Thiongo', 'Kenya');",
        "",
        "INSERT INTO book VALUES",
        "  (1, 'When Rain Clouds Gather', 1, 145.00, 1968),",
        "  (2, 'Maru',                    1, 130.00, 1971),",
        "  (3, 'Things Fall Apart',       2, 160.00, 1958),",
        "  (4, 'The Screaming of the Innocent', 3, 150.00, 2002),",
        "  (5, 'A Grain of Wheat',        4, 155.00, 1967);",
        "",
        "INSERT INTO sale VALUES",
        "  (1, 1, 3, '2026-02-02'), (2, 3, 5, '2026-02-02'), (3, 2, 1, '2026-02-03'),",
        "  (4, 3, 2, '2026-02-04'), (5, 5, 4, '2026-02-05'), (6, 1, 2, '2026-02-06'),",
        "  (7, 4, 1, '2026-02-06'), (8, 3, 6, '2026-02-07');"
      ]
    }
  ],
  "examples": [
    {
      "id": "create-and-select",
      "label": "Create and SELECT",
      "code": [
        "CREATE TABLE student (id INTEGER PRIMARY KEY, name TEXT, course TEXT, mark INTEGER);",
        "",
        "INSERT INTO student (name, course, mark) VALUES",
        "  ('Kabo',   'CSI141', 78),",
        "  ('Naledi', 'CSI141', 91),",
        "  ('Thato',  'CSI243', 64),",
        "  ('Lesedi', 'CSI243', 85);",
        "",
        "SELECT * FROM student;"
      ]
    },
    {
      "id": "where-and-order-by",
      "label": "WHERE and ORDER BY",
      "code": [
        "CREATE TABLE student (id INTEGER PRIMARY KEY, name TEXT, course TEXT, mark INTEGER);",
        "INSERT INTO student (name, course, mark) VALUES",
        "  ('Kabo', 'CSI141', 78), ('Naledi', 'CSI141', 91),",
        "  ('Thato', 'CSI243', 64), ('Lesedi', 'CSI243', 85);",
        "",
        "SELECT name, mark",
        "FROM student",
        "WHERE mark >= 70",
        "ORDER BY mark DESC;"
      ]
    },
    {
      "id": "group-by-and-aggregates",
      "label": "GROUP BY and aggregates",
      "code": [
        "CREATE TABLE student (id INTEGER PRIMARY KEY, name TEXT, course TEXT, mark INTEGER);",
        "INSERT INTO student (name, course, mark) VALUES",
        "  ('Kabo', 'CSI141', 78), ('Naledi', 'CSI141', 91),",
        "  ('Thato', 'CSI243', 64), ('Lesedi', 'CSI243', 85);",
        "",
        "SELECT course,",
        "       COUNT(*)  AS students,",
        "       AVG(mark) AS average,",
        "       MAX(mark) AS best",
        "FROM student",
        "GROUP BY course",
        "HAVING COUNT(*) > 1;"
      ]
    },
    {
      "id": "join-two-tables",
      "label": "JOIN two tables",
      "code": [
        "CREATE TABLE course  (code TEXT PRIMARY KEY, title TEXT);",
        "CREATE TABLE student (id INTEGER PRIMARY KEY, name TEXT, course TEXT REFERENCES course(code));",
        "",
        "INSERT INTO course VALUES ('CSI141', 'Programming Principles'), ('CSI243', 'Functional Programming'), ('CSI323', 'Algorithms');",
        "INSERT INTO student (name, course) VALUES ('Kabo', 'CSI141'), ('Naledi', 'CSI141'), ('Thato', 'CSI243');",
        "",
        "-- INNER JOIN drops CSI323 (no students); LEFT JOIN keeps it.",
        "SELECT c.code, c.title, s.name",
        "FROM course c",
        "LEFT JOIN student s ON s.course = c.code",
        "ORDER BY c.code;"
      ]
    },
    {
      "id": "update-and-delete",
      "label": "UPDATE and DELETE",
      "code": [
        "CREATE TABLE item (id INTEGER PRIMARY KEY, label TEXT, qty INTEGER);",
        "INSERT INTO item (label, qty) VALUES ('pen', 10), ('book', 3), ('bag', 0);",
        "",
        "UPDATE item SET qty = qty + 5 WHERE label = 'book';",
        "DELETE FROM item WHERE qty = 0;",
        "",
        "SELECT * FROM item;"
      ]
    },
    {
      "id": "subquery",
      "label": "Subquery",
      "code": [
        "CREATE TABLE student (id INTEGER PRIMARY KEY, name TEXT, mark INTEGER);",
        "INSERT INTO student (name, mark) VALUES ('Kabo', 78), ('Naledi', 91), ('Thato', 64), ('Lesedi', 85);",
        "",
        "-- Students scoring above the class average",
        "SELECT name, mark",
        "FROM student",
        "WHERE mark > (SELECT AVG(mark) FROM student);"
      ]
    },
    {
      "id": "university-list-students",
      "label": "University: list students",
      "seed": "university",
      "code": [
        "-- The university database is already created for you.",
        "SELECT * FROM student;"
      ]
    },
    {
      "id": "university-join-three-tables",
      "label": "University: join three tables",
      "seed": "university",
      "code": [
        "SELECT s.name, c.title, e.mark",
        "FROM enrolment e",
        "JOIN student s ON s.id = e.student_id",
        "JOIN course  c ON c.code = e.course_code",
        "ORDER BY e.mark DESC;"
      ]
    },
    {
      "id": "university-average-mark-per-course",
      "label": "University: average mark per course",
      "seed": "university",
      "code": [
        "SELECT c.code, c.title,",
        "       COUNT(e.mark)         AS marked,",
        "       ROUND(AVG(e.mark), 1) AS average",
        "FROM course c",
        "LEFT JOIN enrolment e ON e.course_code = c.code",
        "GROUP BY c.code",
        "ORDER BY average DESC;"
      ]
    },
    {
      "id": "university-students-with-no-mark-yet",
      "label": "University: students with no mark yet",
      "seed": "university",
      "code": [
        "-- Comparing with = NULL never matches. Use IS NULL.",
        "SELECT s.name, e.course_code",
        "FROM enrolment e",
        "JOIN student s ON s.id = e.student_id",
        "WHERE e.mark IS NULL;"
      ]
    },
    {
      "id": "bookshop-revenue-per-author",
      "label": "Bookshop: revenue per author",
      "seed": "bookshop",
      "code": [
        "SELECT a.name,",
        "       SUM(b.price * s.quantity) AS revenue",
        "FROM sale s",
        "JOIN book   b ON b.id = s.book_id",
        "JOIN author a ON a.id = b.author_id",
        "GROUP BY a.id",
        "ORDER BY revenue DESC;"
      ]
    }
  ]
}
