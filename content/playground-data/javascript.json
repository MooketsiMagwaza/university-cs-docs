{
  "$schema": "./playground.schema.json",
  "language": "javascript",
  "seeds": [
    {
      "id": "class-marks",
      "label": "Class marks",
      "description": "Defines students, an array of objects with a name, a year and an array of marks.",
      "code": [
        "const students = [",
        "  { name: 'Kabo',      year: 2, marks: [78, 64, 55] },",
        "  { name: 'Naledi',    year: 3, marks: [91, 84, 77] },",
        "  { name: 'Thato',     year: 2, marks: [48, 69] },",
        "  { name: 'Lesedi',    year: 1, marks: [85, 72] },",
        "  { name: 'Boitumelo', year: 2, marks: [88] },",
        "];"
      ]
    },
    {
      "id": "shop-cart",
      "label": "Shopping cart",
      "description": "Defines cart, an array of items with a name, a price in pula and a quantity.",
      "code": [
        "const cart = [",
        "  { item: 'Notebook', price: 20, quantity: 3 },",
        "  { item: 'Pen',      price: 5,  quantity: 10 },",
        "  { item: 'Backpack', price: 250, quantity: 1 },",
        "  { item: 'Ruler',    price: 8,  quantity: 2 },",
        "];"
      ]
    }
  ],
  "examples": [
    {
      "id": "hello-console",
      "label": "Hello, console",
      "code": [
        "console.log('Hello, University Docs!');",
        "console.log(2 + 3 * 4);",
        "console.log([1, 2, 3].map((n) => n * 2));"
      ]
    },
    {
      "id": "variables-and-types",
      "label": "Variables and types",
      "code": [
        "const name = 'Ada';",
        "let age = 36;",
        "const scores = [90, 72, 85];",
        "const student = { name, age, scores };",
        "",
        "console.log(typeof name, typeof age, typeof scores, typeof student);",
        "console.log(student);"
      ]
    },
    {
      "id": "loops-and-functions",
      "label": "Loops and functions",
      "code": [
        "function isPrime(n) {",
        "  if (n < 2) return false;",
        "  for (let i = 2; i * i <= n; i++) {",
        "    if (n % i === 0) return false;",
        "  }",
        "  return true;",
        "}",
        "",
        "for (let n = 1; n <= 20; n++) {",
        "  if (isPrime(n)) console.log(n, 'is prime');",
        "}"
      ]
    },
    {
      "id": "array-methods",
      "label": "Array methods",
      "code": [
        "const nums = [5, 3, 8, 1, 9, 2];",
        "",
        "console.log('sorted  :', [...nums].sort((a, b) => a - b));",
        "console.log('evens   :', nums.filter((n) => n % 2 === 0));",
        "console.log('doubled :', nums.map((n) => n * 2));",
        "console.log('sum     :', nums.reduce((total, n) => total + n, 0));",
        "console.log('max     :', Math.max(...nums));"
      ]
    },
    {
      "id": "recursion",
      "label": "Recursion",
      "code": [
        "const factorial = (n) => (n <= 1 ? 1 : n * factorial(n - 1));",
        "const fib = (n) => (n < 2 ? n : fib(n - 1) + fib(n - 2));",
        "",
        "console.log('6! =', factorial(6));",
        "console.log('fib 0..12:', Array.from({ length: 13 }, (_, i) => fib(i)));"
      ]
    },
    {
      "id": "classes",
      "label": "Classes",
      "code": [
        "class Stack {",
        "  #items = [];",
        "  push(x) { this.#items.push(x); return this; }",
        "  pop() { return this.#items.pop(); }",
        "  get size() { return this.#items.length; }",
        "}",
        "",
        "const s = new Stack().push(1).push(2).push(3);",
        "console.log('size:', s.size);",
        "console.log('pop :', s.pop());",
        "console.log('size:', s.size);"
      ]
    },
    {
      "id": "async-and-promises",
      "label": "Async and promises",
      "code": [
        "const wait = (ms, value) => new Promise((resolve) => setTimeout(() => resolve(value), ms));",
        "",
        "console.log('start');",
        "const a = await wait(300, 'first');",
        "console.log(a);",
        "const [b, c] = await Promise.all([wait(200, 'second'), wait(100, 'third')]);",
        "console.log(b, c);",
        "console.log('done');"
      ]
    },
    {
      "id": "class-marks-summarise-with-reduce",
      "label": "Class marks: summarise with reduce",
      "seed": "class-marks",
      "code": [
        "// students is already defined by the Class marks dataset.",
        "const average = (xs) => xs.reduce((a, b) => a + b, 0) / xs.length;",
        "",
        "for (const s of students) {",
        "  console.log(s.name.padEnd(10), average(s.marks).toFixed(1));",
        "}",
        "",
        "const best = students.reduce((a, b) => (average(b.marks) > average(a.marks) ? b : a));",
        "console.log('Best average:', best.name);"
      ]
    },
    {
      "id": "shopping-cart-totals",
      "label": "Shopping cart: totals",
      "seed": "shop-cart",
      "code": [
        "// cart is already defined by the Shopping cart dataset.",
        "const lineTotal = ({ price, quantity }) => price * quantity;",
        "const total = cart.reduce((sum, line) => sum + lineTotal(line), 0);",
        "",
        "for (const line of cart) console.log(line.item.padEnd(10), 'P' + lineTotal(line));",
        "console.log('Total:   P' + total);"
      ]
    }
  ]
}
