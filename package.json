{
  "name": "university-docs",
  "version": "0.0.0",
  "private": true,
  "description": "An open, interactive Computer Science study hub for University of Botswana courses.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MooketsiMagwaza/university-cs-docs.git"
  },
  "bugs": {
    "url": "https://github.com/MooketsiMagwaza/university-cs-docs/issues"
  },
  "homepage": "https://university-cs-docs.vercel.app",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "check": "npm run audit:content && npm run types:check && npm run build",
    "check:full": "npm run audit:content:full && npm run types:check && npm run build && npm run test:browser && npm run test:csi247-study-guides",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "audit:content": "npm run audit:quizzes && npm run audit:csi247-architecture && npm run audit:csi247-java && npm run audit:java-playground-assets",
    "audit:content:full": "npm run audit:content && npm run audit:csi247-study-guides && npm run audit:csi247-study-guide-java",
    "audit:csi247-architecture": "node scripts/audit-csi247-architecture.mjs",
    "audit:csi247-java": "node scripts/audit-csi247-java-examples.mjs",
    "audit:csi247-study-guides": "node scripts/build-csi247-study-guides.mjs --audit-only",
    "audit:csi247-study-guide-java": "node scripts/verify-csi247-study-guide-java.mjs",
    "build:csi247-study-guides": "node scripts/build-csi247-study-guides.mjs --pdf --verify",
    "test:csi247-study-guides": "node scripts/build-csi247-study-guides.mjs --audit-only --verify",
    "test:csi247-markdown": "node scripts/test-csi247-markdown.mjs",
    "test:csi247-illustrations": "node scripts/test-csi247-illustrations.mjs",
    "audit:java-playground-assets": "node scripts/audit-java-playground-assets.mjs",
    "test:browser": "playwright test",
    "test:java-playground": "playwright test tests/java-playground.spec.ts",
    "audit:mat221-fidelity": "node scripts/audit-mat221-fidelity.mjs",
    "audit:quizzes": "node scripts/audit-quiz-data.mjs",
    "audit:playgrounds": "node scripts/audit-playground-data.mjs",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.40.0",
    "fumadocs-core": "16.9.3",
    "fumadocs-mdx": "15.0.10",
    "fumadocs-ui": "16.9.3",
    "katex": "^0.18.2",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.4.1",
    "next": "16.3.8",
    "parse5": "8.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^5.1.16"
    },
    "lodash-es": "^4.18.0"
  }
}
